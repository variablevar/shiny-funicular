{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": 100,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "GBP",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "cancel_open_orders_on_exit": false,
    "process_throttle_secs": 5,
    "timeframe": "5m",
    "entry_pricing": {
        "price_side": "other",
        "price_last_balance": 0.0,
        "use_order_book": true,
        "order_book_top": 1,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "other",
        "price_last_balance": 0.0,
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {
            "options": {
                "defaultType": "future"
            }
        },
        "ccxt_async_config": {
            "options": {
                "defaultType": "future"
            }
        },
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": ""
    },
    "api_server": {
        "enabled": false,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": true,
        "jwt_secret_key": "u60VE0jaUCfTBVheDdarwGyN33POTudezXk-jWlkITg",
        "ws_token": "gtquant-ws-token-u60VE0jaUCfTBVheDdarwGyN33POTude",
        "CORS_origins": [],
        "username": "gtquant",
        "password": "gtquant"
    },
    "bot_name": "gtquant",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 5
    },
    "freqai": {
        "enabled": true,
        "identifier": "gtquant-v0.2-regime-gated",
        "train_period_days": 30,
        "backtest_period_days": 7,
        "live_retrain_hours": 24,
        "expiration_hours": 168,
        "save_backtest_models": true,
        "write_metrics_to_disk": true,
        "activate_tensorboard": false,
        "keras": false,
        "feature_parameters": {
            "include_timeframes": [
                "5m",
                "15m",
                "30m",
                "1h",
                "4h"
            ],
            "include_corr_pairlist": [
                "BTC/USDT:USDT",
                "ETH/USDT:USDT"
            ],
            "include_shifted_candles": 3,
            "indicator_periods_candles": [
                8,
                14,
                20,
                50
            ],
            "label_period_candles": 100,
            "DI_threshold": 20,
            "weight_factor": 0.9,
            "buffer_train_data_candles": 100,
            "principal_component_analysis": false,
            "use_SVM_to_remove_outliers": false,
            "plot_feature_importances": 10
        },
        "data_split_parameters": {
            "test_size": 0.2,
            "random_state": 42,
            "shuffle": false
        },
        "model_training_parameters": {
            "objective": "regression",
            "learning_rate": 0.05,
            "num_leaves": 31,
            "min_data_in_leaf": 20,
            "feature_fraction": 0.8,
            "n_estimators": 500
        },
        "rl_config": {
            "drop_ohlc_from_features": false,
            "train_cycles": 1,
            "max_trade_duration_candles": 100,
            "model_type": "ppo",
            "policy_type": "MlpPolicy"
        }
    }
}